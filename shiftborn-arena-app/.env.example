# Colyseus and HTTP port.
PORT=2567
# Browser origin allowed to open WebSocket connections.
PUBLIC_ORIGIN=http://localhost:5173
# Quick-play mode: frenzy, zoneFrenzy, or alternate.
QUICKPLAY_MODE=frenzy
# Bot tier: easy, normal, or hard.
BOT_DIFFICULTY=normal
# Directory reserved for match and input logs.
MATCH_LOG_DIR=./data/matches
# Enable development commands only when explicitly set to 1.
DEV_CHEATS=0
# Pino level: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info
# Local build identifier.
BUILD_ID=dev
