{
  "name": "shiftborn-arena",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm --filter @shiftborn/client exec playwright install chromium",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "vitest run",
    "test:e2e": "node -e \"console.log('not implemented yet (T-068)')\"",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write --ignore-unknown apps packages tools test eslint.config.js package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.json",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck && tsc --noEmit -p tsconfig.json",
    "check:size": "node scripts/checkSize.mjs",
    "sim:determinism": "node -e \"console.log('not implemented yet (T-056)')\"",
    "map:validate": "pnpm --filter @shiftborn/shared build && pnpm --filter @shiftborn/map-validator build && pnpm --filter @shiftborn/map-validator validate",
    "analyze": "node -e \"console.log('not implemented yet (T-067)')\"",
    "replay": "node -e \"console.log('not implemented yet (T-028)')\"",
    "loadtest": "node -e \"console.log('not implemented yet (T-141)')\""
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
